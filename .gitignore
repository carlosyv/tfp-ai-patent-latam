# =============================================================================
# .gitignore — tfp-ai-patent-latam
# =============================================================================
# Publication replication package for:
# "The Impact of AI Adoption on Total Factor Productivity (TFP) in Latin America"
# =============================================================================

# ------------------------------------------------------------------------------
# Python artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.so

# ------------------------------------------------------------------------------
# Virtual environments
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
tfp-ai-patent/
# ------------------------------------------------------------------------------
# OS metadata
# ------------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# IDE / editor files
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# Archive — legacy pipeline variants (pre-v5 internal development history,
# not part of the publication package)
# ------------------------------------------------------------------------------
archive/
output/results/archive/

# ------------------------------------------------------------------------------
# Data — large uncompressed ILOSTAT file. The pipeline reads the .gz directly,
# so the uncompressed CSV should never be committed.
# ------------------------------------------------------------------------------
data/EMP_TEMP_SEX_AGE_NB_A-20260325T1614.csv

# ------------------------------------------------------------------------------
# Legacy H3 robustness output (pre-v5, generated on demand)
# ------------------------------------------------------------------------------
output/h3_institutional_comparison/

# ------------------------------------------------------------------------------
# Panel C — raw EDGAR corpus and API cache (NOT committed)
#
# filings_txt/ holds 847 raw 20-F/10-K text files (~942 MB) downloaded from SEC
# EDGAR; cache/ holds intermediate API pulls (~16 MB). Both are re-derivable
# source material, not analysis output, and committing them would grow a ~9 MB
# repository by two orders of magnitude.
#
# Regeneration: panel_c/build_universe.py (firm universe) then
# panel_c/fetch_filings.py (downloads filings_txt/ and populates cache/).
# panel_c/filings_manifest.csv is committed and records the exact accession
# numbers, so the corpus is reproducible file-for-file.
#
# The derived CSVs the analysis actually consumes (firm_universe.csv,
# firm_ai_exposure.csv, firm_financials.csv, firm_employees.csv,
# firm_panel.csv, firm_panel_clean.csv) ARE committed.
# ------------------------------------------------------------------------------
panel_c/filings_txt/
panel_c/cache/

# Jupyter notebooks (if any)
*.ipynb_checkpoints/
.ipynb_checkpoints/

# Logs
*.log
